{
    "name": "predev-solutions/egypt-validators",
    "description": "Validate and parse Egyptian national IDs, mobile numbers and governorates. Framework-agnostic PHP with Laravel validation rules.",
    "type": "library",
    "license": "MIT",
    "keywords": ["egypt", "national-id", "validation", "laravel", "mobile", "phone", "governorate", "arabic"],
    "homepage": "https://github.com/predev-solutions/egypt-validators",
    "authors": [{"name": "predev. Solutions", "email": "contact@predevsolutions.com", "homepage": "https://predevsolutions.com"}],
    "require": {"php": "^8.2"},
    "require-dev": {"phpunit/phpunit": "^11.0", "illuminate/validation": "^11.0|^12.0", "illuminate/translation": "^11.0|^12.0"},
    "suggest": {"illuminate/validation": "To use the Laravel validation rules"},
    "autoload": {"psr-4": {"Predev\\EgyptValidators\\": "src/"}},
    "autoload-dev": {"psr-4": {"Predev\\EgyptValidators\\Tests\\": "tests/"}},
    "scripts": {"test": "phpunit"},
    "config": {"sort-packages": true},
    "minimum-stability": "stable"
}
